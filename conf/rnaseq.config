params {
    // Resource management
    max_cpus = 48
    max_memory = '256.GB'
    max_time = '240.h'
}

singularity {
    enabled = true
    autoMounts = true
    cacheDir = "$NXF_SINGULARITY_CACHEDIR"
}

process {
    executor='slurm'
    queue='production'
    queueSize=500
    exitReadTimeout='100000 sec'
    pollInterval = '5sec'
    cpus = 2
    memory = '8.GB'
    time = '4.h'

    // Specific resource allocation
    withName: 'STAR_ALIGN' {
        cpus = 16
        memory = '64.GB'
        time = '8.h'
    }

    withName: 'SALMON_QUANT' {
        cpus = 8
        memory = '16.GB'
        time = '4.h'
    }
}

process.errorStrategy = 'retry'
process.maxRetries = 2

// Execution reports
timeline.enabled = true
report.enabled = true
trace.enabled = true
dag.enabled = true
