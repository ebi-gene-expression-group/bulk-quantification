params {
    // Resource management
    max_cpus = 48
    max_memory = '256.GB'
    max_time = '240.h'
}

singularity {
    enabled = true
    autoMounts = true
    cacheDir = "$NXF_SINGULARITY_CACHEDIR"
}

process {
    executor='slurm'
    // change below to variable
    queue='production'
    queueSize=500
    exitReadTimeout='100000 sec'
    pollInterval = '5sec'

    // Default resources: increase memory on retry using task.attempt
    // task.attempt is 1 on the first try, 2 on the first retry, etc.
    cpus = 2
    memory = { 8.GB + (task.attempt - 1) * 8.GB }   // 1st attempt: 8.GB, 2nd: 16.GB, 3rd: 24.GB, ...
    time = '4.h'

    // Specific resource allocation (also increases memory on retry)

    withName: '.*STAR_ALIGN' {
        cpus = 9
        memory = { task.attempt == 1 ? 48.GB :
                   task.attempt == 2 ? 64.GB :
                                       80.GB }
        time   = { task.attempt == 1 ? 1.h :
                   task.attempt == 2 ? 2.h :
                                       4.h }
    }

    withName: '.*SORTMERNA' {
        cpus = 8
        memory = { task.attempt == 1 ? 12.GB :
                   task.attempt == 2 ? 32.GB :
                                       48.GB }
        time   = { task.attempt == 1 ? 3.h :
                   task.attempt == 2 ? 5.h :
                                       8.h }
    }

    withName: '.*SALMON_QUANT' {
        cpus = 5
        memory = { task.attempt == 1 ? 24.GB :
                   task.attempt == 2 ? 32.GB :
                                       48.GB }
        time   = { task.attempt == 1 ? 30.m :
                   task.attempt == 2 ? 1.h :
                                       2.h }
    }

    withName: '.*TRIMGALORE' {
        cpus = 7
        memory = { task.attempt == 1 ? 2.GB :
                   task.attempt == 2 ? 6.GB :
                                      12.GB }
        time   = { task.attempt == 1 ? 30.m :
                   task.attempt == 2 ? 1.h :
                                       2.h }
    }

    withName: '.*KRAKEN2' {
        cpus = 2
        memory = { task.attempt == 1 ? 10.GB :
                   task.attempt == 2 ? 16.GB :
                                       24.GB }
        time   = { task.attempt == 1 ? 15.m :
                   task.attempt == 2 ? 30.m :
                                        1.h }
    }

    withName: '.*SAMTOOLS_SORT' {
        cpus = 4
        memory = { task.attempt == 1 ? 7.GB :
                   task.attempt == 2 ? 12.GB :
                                       20.GB }
        time   = { task.attempt == 1 ? 15.m :
                   task.attempt == 2 ? 30.m :
                                        1.h }
    }

    withName: '.*BRACKEN' {
        cpus = 1
        memory = { task.attempt == 1 ? 1.GB :
                   task.attempt == 2 ? 2.GB :
                                       4.GB }
        time   = { task.attempt == 1 ? 16.h :
                   task.attempt == 2 ? 20.h :
                                       24.h }
    }
}

workflow {
  failOnIgnore = false
}


process.errorStrategy = 'retry'
process.maxRetries = 5

// Execution reports
timeline.enabled = true
report.enabled = true
trace.enabled = true
dag.enabled = true
