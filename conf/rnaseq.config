params {
    // Resource management
    max_cpus = 48
    max_memory = '256.GB'
    max_time = '240.h'
}

singularity {
    enabled = true
    autoMounts = true
    cacheDir = "$NXF_SINGULARITY_CACHEDIR"
}

process {
    executor='slurm'
    queue='production'
    queueSize=500
    exitReadTimeout='100000 sec'
    pollInterval = '5sec'

    // Default resources: increase memory on retry using task.attempt
    // task.attempt is 1 on the first try, 2 on the first retry, etc.
    cpus = 2
    memory = { 8.GB + (task.attempt - 1) * 8.GB }   // 1st attempt: 8.GB, 2nd: 16.GB, 3rd: 24.GB, ...
    time = '4.h'

    // Specific resource allocation (also increases memory on retry)
    withName: 'STAR_ALIGN' {
        cpus = 16
        memory = { 64.GB + (task.attempt - 1) * 16.GB } // 1st: 64.GB, 2nd: 80.GB, ...
        time = '8.h'
    }

    withName: 'SALMON_QUANT' {
        cpus = 8
        memory = { 16.GB + (task.attempt - 1) * 8.GB } // 1st: 16.GB, 2nd: 24.GB, ...
        time = '4.h'
    }
}

process.errorStrategy = 'retry'
process.maxRetries = 5

// Execution reports
timeline.enabled = true
report.enabled = true
trace.enabled = true
dag.enabled = true
