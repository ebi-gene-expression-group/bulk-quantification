params {
    // Resource management
    max_cpus = 48
    max_production_memory = 468.GB

    // Use the job-local scratch filesystem for Parabricks temporary files.
    parabricks_tmp_dir = '/lscratch'
}

singularity {
    enabled = true
    autoMounts = true
    cacheDir = "$NXF_SINGULARITY_CACHEDIR"
}

process {
    executor='slurm'
    // change below to variable
    queue='production'

    // Default resources: increase memory on retry using task.attempt
    // task.attempt is 1 on the first try, 2 on the first retry, etc.
    cpus = 2
    memory = { 8.GB + (task.attempt - 1) * 8.GB }   // 1st attempt: 8.GB, 2nd: 16.GB, 3rd: 24.GB, ...
    time = '4.h'

    // Specific resource allocation (also increases memory on retry)

    withName: '.*STAR_ALIGN' {
        cpus = 24
        memory = { 48.GB + (task.attempt - 1) * 40.GB }
        time   = { 2.h + (task.attempt - 1) * 4.h }
    }

    // Default policy for GPU-labelled processes. Parabricks overrides this
    // below to request two A100 GPUs and the recommended CPU allocation.
    withLabel: process_gpu {
        // Omit --partition so the cluster's GPU auto-routing rules can select
        // the appropriate partition from the requested GPU resource.
        queue = null
        clusterOptions = '--gres=gpu:a100:1'
        // Keep retry escalation within the A100 node capacity (48 CPUs,
        // approximately 449 GB usable memory). Start with one regular
        // memory slice and add a little headroom over the original 72 GB.
        // maxRetries counts retries after the initial attempt, so this allows
        // four total attempts and avoids the fifth attempt requesting 60 CPUs.
        maxRetries = 3
        cpus = { task.attempt > 4 ? 48 : 12 * task.attempt }
        memory = { 80.GB * task.attempt }
        beforeScript = '''
            echo "=== GPU diagnostics (stdout) ==="
            nvidia-smi
            echo "=== GPU diagnostics (stderr) ===" >&2
            nvidia-smi -L >&2

            # Sample aggregate GPU usage throughout the task.  Keep the
            # monitor in the background and stop it when the task exits.
            nvidia-smi dmon -s putm -o DT -d 5 > gpu_dmon.log 2>&1 &
            gpu_dmon_pid=$!
            trap 'kill "$gpu_dmon_pid" 2>/dev/null || true; wait "$gpu_dmon_pid" 2>/dev/null || true' EXIT
        '''
    }

    // STAR index generation is not GPU-labelled, so give it the same shared
    // starting resources while allowing its longer setup time.
    withName: '.*PARABRICKS_STARGENOMEGENERATE.*' {
        cpus       = { 12 * task.attempt }
        memory     = { 80.GB * task.attempt }
        time       = 48.h
        maxRetries = 3
    }

    // Keep the longer limit for full Parabricks RNA-seq tasks. Keep CPUs
    // fixed at 24 so retries do not request the slower 48-CPU allocation;
    // memory and walltime can still increase with each retry.
    withName: '.*PARABRICKS_RNAFQ2BAM.*' {
        cpus = 24
        time = { 12.h * task.attempt }
    }

    // Make the job-local scratch mount visible inside the Parabricks
    // container. Docker already sees host paths directly; Singularity and
    // Apptainer need an explicit bind on systems without automatic mounts.
    withName: '.*ALIGN_STAR:PARABRICKS_RNA_FQ2BAM' {
        // Parabricks uses the accelerator directive to emit --num-gpus.
        accelerator = 2
        clusterOptions = '--gres=gpu:a100:2'

        // Keep the recommended 24 CPUs on every attempt. Start with half of
        // the usable A100-node RAM and add 80 GB per retry.
        cpus = 24
        memory = { 160.GB + (task.attempt - 1) * 80.GB }

        containerOptions = {
            def defaultGpuOptions = workflow.containerEngine in ['singularity', 'apptainer'] ? '--nv' : '--gpus all'
            def gpuOptions = params.gpu_container_options ?: defaultGpuOptions
            workflow.containerEngine in ['singularity', 'apptainer']
                ? "${gpuOptions} --bind /lscratch:/lscratch"
                : gpuOptions
        }
    }

    withName: '.*SORTMERNA' {
        cpus = 8
        memory = { 32.GB + (task.attempt - 1) * 200.GB }

        // Use the partition only up to the threshold; omit it above that
        // Also adjust the time allocation
        queue  = { task.memory > params.max_production_memory ? null : 'production' }
        time   = { task.memory > params.max_production_memory ? 720.h : 168.h }
    }

    withName: '.*SALMON_QUANT' {
        cpus = 8
        memory = { 28.GB + (task.attempt - 1) * 40.GB }
        time   = 168.h
    }

    withName: '.*TRIMGALORE' {
        cpus = 8
        memory = { 2.GB + (task.attempt - 1) * 4.GB }
        time   = { task.attempt * 2.h }
    }

    withName: '.*KRAKEN2' {
        cpus = 2
        memory = { 10.GB + (task.attempt - 1) * 8.GB }
        time   = { task.attempt * 30.m }
    }

    withName: '.*SAMTOOLS_SORT' {
        cpus = 8
        memory = { task.attempt * 7.GB }
        time   = { task.attempt * 30.m }
    }

    withName: '.*BRACKEN' {
        cpus = 1
        memory = { task.attempt * 2.GB }
        time   = { task.attempt * 16.h }
        errorStrategy = 'ignore'
    }
}

workflow {
  failOnIgnore = false
}

executor {
    queueSize = 500
    exitReadTimeout = '120 sec'
    pollInterval = '5 sec'
}

process.errorStrategy = 'retry'
process.maxRetries = 5

// Execution reports
timeline.enabled = true
report.enabled = true
trace.enabled = true
dag.enabled = true
