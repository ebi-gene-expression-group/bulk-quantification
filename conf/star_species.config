params {
  star_base_args = [
    '--quantMode TranscriptomeSAM',
    '--outSAMtype BAM Unsorted',
    '--outSAMattributes NH HI AS NM MD',
    '--readFilesCommand zcat',
    '--twopassMode Basic',
    '--runRNGseed 0',
    '--alignSJDBoverhangMin 1',
    '--outSAMstrandField intronMotif',
    '--quantTranscriptomeSAMoutput BanSingleEnd'
  ].join(' ')
}

profiles {
  dicot_plants {
    process {
      withName: 'NFCORE_RNASEQ:RNASEQ:ALIGN_STAR:STAR_ALIGN' {
        ext.args = "${params.star_base_args} --outFilterMultimapNmax 100 --alignIntronMax 50000 --outFilterIntronMotifs None"
      }
    }
  }
  monocot_plants {
    process {
      withName: 'NFCORE_RNASEQ:RNASEQ:ALIGN_STAR:STAR_ALIGN' {
        ext.args = "${params.star_base_args} --outFilterMultimapNmax 20 --alignIntronMax 20000 --outFilterIntronMotifs None"
      }
    }
  }
  bryophytes_plants {
    process {
      withName: 'NFCORE_RNASEQ:RNASEQ:ALIGN_STAR:STAR_ALIGN' {
        ext.args = "${params.star_base_args} --outFilterMultimapNmax 20 --alignIntronMax 5000 --outFilterIntronMotifs RemoveNoncanonical"
      }
    }
  }
  yeast {
    process {
      withName: 'NFCORE_RNASEQ:RNASEQ:ALIGN_STAR:STAR_ALIGN' {
        ext.args = "${params.star_base_args} --outFilterMultimapNmax 20 --alignIntronMax 5000 --outFilterIntronMotifs None"
      }
    }
  }
}
