profiles {
  extreme {
    process {
      withName: 'NFCORE_RNASEQ:RNASEQ:ALIGN_STAR:STAR_ALIGN' {
        ext.args = { 
          "${task.ext.args ?: ''} --alignIntronMax 50000 --outFilterIntronMotifs None --outFilterMultimapNmax 100".trim()
        }
        beforeScript = 'echo "EXTREME PROFILE APPLIED FOR STAR_ALIGN"'
      }
    }
  }
}
